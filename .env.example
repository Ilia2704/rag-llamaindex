# YandexGPT / Yandex Cloud
YC_API_KEY=
YC_FOLDER_ID=
OPENAI_MODEL=gpt://<YC_FOLDER_ID>/yandexgpt-lite/latest
EVAL_MODEL=
RAGAS_EMBEDDING_MODEL=emb://<YC_FOLDER_ID>/text-embeddings/latest
TOX_MODEL=gpt://<YC_FOLDER_ID>/yandexgpt/latest

# Optional external providers
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Providers used by testing/run_ragas_demo_test.py
# Use PROVIDER=yandex with OPENAI_MODEL=gpt://...
# Use PROVIDER=ollama with OPENAI_MODEL empty or set to an Ollama model name.
PROVIDER=yandex
EVAL_PROVIDER=yandex
EMBEDDING_PROVIDER=yandex
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# RAGAS quality gates
RAGAS_COLLECTION_NAME=robotex_docs_llamaindex
RAGAS_REFERENCE_FREE=0
USE_SIMPLE_AR=1
THRESH_FAITHFULNESS=0.80
THRESH_CONTEXT_RELEVANCE=0.50
THRESH_ANSWER_RELEVANCY=0.50
THRESH_CONTEXT_PRECISION=0.50
THRESH_CONTEXT_RECALL=0.70
THRESH_QA_SIM=0.80
THRESH_PASS_RATE=0.85

# Toxicity gate
TOX_THRESHOLD=0.50
RUDE_THRESHOLD=0.50

# MLflow
MLFLOW_ENABLED=1
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=rag-engineering-workshop
MLFLOW_RUN_NAME=ragas_robotex_test

# Langfuse tracing
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Local Langfuse stack
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=langfuse-local-nextauth-secret-change-me
LANGFUSE_SALT=langfuse-local-salt-change-me
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_POSTGRES_USER=postgres
LANGFUSE_POSTGRES_PASSWORD=postgres
LANGFUSE_POSTGRES_DB=postgres
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@langfuse-postgres:5432/postgres
LANGFUSE_DIRECT_URL=postgresql://postgres:postgres@langfuse-postgres:5432/postgres
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_REDIS_AUTH=langfuse-redis-password
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=us-east-1
MINIO_DOCKER_NETWORK=rag-engineering-workshop_default
MODEL_PLACEHOLDER_PREFIX=passed-models

# Neo4j graph demo
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
